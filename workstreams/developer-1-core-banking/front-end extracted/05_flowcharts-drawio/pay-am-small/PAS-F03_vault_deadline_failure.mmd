flowchart TD
  a(["Auto-debit due"])
  b{"Funds available?"}
  c["Fund vault"]
  d["Retry and remind within grace"]
  e{"Deadline reached and vault not full?"}
  f["Offer: extend deadline or refund minus fee"]
  g{"Customer choice"}
  h["Extend per rule"]
  i["Refund pocket minus fee; release stock"]
