flowchart TD
  a(["Customer chooses Credit on an eligible product"])
  b["Vendor reviews buyer identity and history"]
  c{"Vendor accepts?"}
  d["Declined; suggest price-lock"]
  e["Customer accepts terms with PIN (vendor carries risk)"]
  f["Vendor delivers; delivery code confirmed"]
  g["Customer repays installments on repayment screen"]
  h["Each payment passed to vendor less commission"]
  i{"Late payment?"}
  j["Reminders and capped late fee per vendor terms"]
  k(["Fully paid; order closed"])
  a --> b
  b --> c
  c -->|no| d
  c -->|yes| e
  e --> f
  f --> g
  g --> h
  h --> i
  i -->|yes| j
  j --> g
  i -->|no, all paid| k
